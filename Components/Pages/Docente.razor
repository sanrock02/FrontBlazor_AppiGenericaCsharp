@page "/docente"
@rendermode InteractiveServer
@inject FrontBlazor_AppiGenericaCsharp.Services.ApiService Api

<PageTitle>Docentes</PageTitle>

<div class="container mt-4">
    <h3>Gestión de Docentes</h3>

    @* ───────── ALERTA DE EXITO O ERROR ───────── *@
    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="alert @(exito ? "alert-success" : "alert-danger") alert-dismissible fade show">
            @mensaje
            <button type="button" class="btn-close" @onclick="() => mensaje = string.Empty"></button>
        </div>
    }

    @* ───────── BOTON PARA MOSTRAR FORMULARIO DE CREAR ───────── *@
    @if (!mostrarFormulario)
    {
        <button class="btn btn-primary mb-3" @onclick="NuevoRegistro">Nuevo Docente</button>
    }

    @* ───────── LIMITE DE REGISTROS ───────── *@
    <div class="d-flex align-items-center mb-3">
        <label class="form-label me-2 mb-0">Límite:</label>
        <input class="form-control me-2" type="number" style="width:100px" @bind="limite" />
        <button class="btn btn-outline-secondary" @onclick="CargarRegistros">Cargar</button>
    </div>

    @* ───────── FORMULARIO (CREAR / EDITAR) ───────── *@
    @if (mostrarFormulario)
    {
        <div class="card mb-3">
            <div class="card-header">
                @(editando ? "Editar Docente" : "Nuevo Docente")
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Cédula</label>
                        <input class="form-control" type="number" @bind="modelo.cedula" disabled="@editando" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Nombres</label>
                        <input class="form-control" @bind="modelo.nombres" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Apellidos</label>
                        <input class="form-control" @bind="modelo.apellidos" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Género</label>
                        <input class="form-control" @bind="modelo.genero" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Cargo</label>
                        <input class="form-control" @bind="modelo.cargo" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Fecha de Nacimiento</label>
                        <input class="form-control" type="date" @bind="modelo.fecha_nacimiento" @bind:format="yyyy-MM-dd" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Correo</label>
                        <input class="form-control" type="email" @bind="modelo.correo" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Teléfono</label>
                        <input class="form-control" @bind="modelo.telefono" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">URL CVLAC</label>
                        <input class="form-control" @bind="modelo.url_cvlac" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Escalafón</label>
                        <input class="form-control" @bind="modelo.escalafon" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Categoría MinCiencia</label>
                        <input class="form-control" @bind="modelo.cat_minciencia" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Convocatoria MinCiencia</label>
                        <input class="form-control" @bind="modelo.conv_minciencia" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Nacionalidad</label>
                        <input class="form-control" @bind="modelo.nacionalidaad" />
                    </div>
                    <div class="col-md-12 mb-3">
                        <label class="form-label">Perfil</label>
                        <textarea class="form-control" rows="3" @bind="modelo.perfil"></textarea>
                    </div>
                </div>
                <button class="btn btn-success me-2" @onclick="GuardarRegistro">Guardar</button>
                <button class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
            </div>
        </div>
    }

    @* ───────── SPINNER DE CARGA ───────── *@
    @if (cargando)
    {
        <div class="d-flex justify-content-center my-4">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }

    @* ───────── TABLA DE REGISTROS ───────── *@
    @if (!cargando && registros.Any())
    {
        <table class="table table-striped table-hover table-sm">
            <thead class="table-dark">
                <tr>
                    <th>Cédula</th>
                    <th>Nombres</th>
                    <th>Apellidos</th>
                    <th>Cargo</th>
                    <th>Correo</th>
                    <th>Teléfono</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var reg in registros)
                {
                    <tr>
                        <td>@reg["cedula"]</td>
                        <td>@reg["nombres"]</td>
                        <td>@reg["apellidos"]</td>
                        <td>@reg["cargo"]</td>
                        <td>@reg["correo"]</td>
                        <td>@reg["telefono"]</td>
                        <td>
                            <button class="btn btn-warning btn-sm me-1"
                                    @onclick="() => EditarRegistro(reg)">
                                Editar
                            </button>
                            <button class="btn btn-danger btn-sm"
                                    @onclick="() => EliminarRegistro(reg)">
                                Eliminar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @* ───────── MENSAJE CUANDO NO HAY DATOS ───────── *@
    @if (!cargando && !registros.Any())
    {
        <div class="alert alert-warning">No se encontraron registros en la tabla docente.</div>
    }
</div>

@code {
    private List<Dictionary<string, object?>> registros = new();
    private bool cargando = true;
    private bool mostrarFormulario = false;
    private bool editando = false;
    private string mensaje = string.Empty;
    private bool exito = false;
    private int? limite = null;

    private DocenteModel modelo = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarRegistros();
    }

    private async Task CargarRegistros()
    {
        cargando = true;
        registros = await Api.ListarAsync("docente", limite);
        cargando = false;
    }

    private void NuevoRegistro()
    {
        modelo = new DocenteModel();
        editando = false;
        mostrarFormulario = true;
    }

    private void EditarRegistro(Dictionary<string, object?> reg)
    {
        modelo = new DocenteModel
        {
            cedula = Convert.ToInt32(reg["cedula"]),
            nombres = reg["nombres"]?.ToString() ?? "",
            apellidos = reg["apellidos"]?.ToString() ?? "",
            genero = reg["genero"]?.ToString() ?? "",
            cargo = reg["cargo"]?.ToString() ?? "",
            fecha_nacimiento = reg["fecha_nacimiento"] != null ? Convert.ToDateTime(reg["fecha_nacimiento"]) : null,
            correo = reg["correo"]?.ToString() ?? "",
            telefono = reg["telefono"]?.ToString() ?? "",
            url_cvlac = reg["url_cvlac"]?.ToString() ?? "",
            escalafon = reg["escalafon"]?.ToString() ?? "",
            perfil = reg["perfil"]?.ToString() ?? "",
            cat_minciencia = reg["cat_minciencia"]?.ToString(),
            conv_minciencia = reg["conv_minciencia"]?.ToString() ?? "",
            nacionalidaad = reg["nacionalidaad"]?.ToString() ?? ""
        };
        editando = true;
        mostrarFormulario = true;
    }

    private async Task GuardarRegistro()
    {
        var datos = new Dictionary<string, object?>
        {
            { "cedula", modelo.cedula },
            { "nombres", modelo.nombres },
            { "apellidos", modelo.apellidos },
            { "genero", modelo.genero },
            { "cargo", modelo.cargo },
            { "fecha_nacimiento", modelo.fecha_nacimiento?.ToString("yyyy-MM-dd") },
            { "correo", modelo.correo },
            { "telefono", modelo.telefono },
            { "url_cvlac", modelo.url_cvlac },
            { "fecha_actualizacion", DateTime.Now.ToString("yyyy-MM-dd") },
            { "escalafon", modelo.escalafon },
            { "perfil", modelo.perfil },
            { "cat_minciencia", modelo.cat_minciencia },
            { "conv_minciencia", modelo.conv_minciencia },
            { "nacionalidaad", modelo.nacionalidaad }
        };

        if (editando)
        {
            (exito, mensaje) = await Api.ActualizarAsync("docente", "cedula", modelo.cedula.ToString(), datos);
        }
        else
        {
            (exito, mensaje) = await Api.CrearAsync("docente", datos);
        }

        if (exito)
        {
            Cancelar();
            await CargarRegistros();
        }
    }

    private async Task EliminarRegistro(Dictionary<string, object?> reg)
    {
        var cedula = Convert.ToInt32(reg["cedula"]);
        if (!await ConfirmarEliminacion()) return;

        (exito, mensaje) = await Api.EliminarAsync("docente", "cedula", cedula.ToString());
        await CargarRegistros();
    }

    private void Cancelar()
    {
        mostrarFormulario = false;
        modelo = new DocenteModel();
    }

    private Task<bool> ConfirmarEliminacion() => Task.FromResult(true);

    private class DocenteModel
    {
        public int cedula { get; set; }
        public string nombres { get; set; } = "";
        public string apellidos { get; set; } = "";
        public string genero { get; set; } = "";
        public string cargo { get; set; } = "";
        public DateTime? fecha_nacimiento { get; set; }
        public string correo { get; set; } = "";
        public string telefono { get; set; } = "";
        public string url_cvlac { get; set; } = "";
        public string escalafon { get; set; } = "";
        public string perfil { get; set; } = "";
        public string? cat_minciencia { get; set; }
        public string conv_minciencia { get; set; } = "";
        public string nacionalidaad { get; set; } = "";
    }
}
