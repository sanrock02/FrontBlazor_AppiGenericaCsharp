@page "/estudio-ac"
@rendermode InteractiveServer
@inject FrontBlazor_AppiGenericaCsharp.Services.ApiService Api

<PageTitle>Estudios por Área de Conocimiento</PageTitle>

<div class="container mt-4">
    <h3>Gestión de Estudios por Área de Conocimiento</h3>

    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="alert @(exito ? "alert-success" : "alert-danger") alert-dismissible fade show">
            @mensaje
            <button type="button" class="btn-close" @onclick="() => mensaje = string.Empty"></button>
        </div>
    }

    @if (!mostrarFormulario)
    {
        <button class="btn btn-primary mb-3" @onclick="NuevoRegistro">Nuevo Registro</button>
    }

    @if (mostrarFormulario)
    {
        <div class="card mb-3">
            <div class="card-header">
                @(editando ? "Editar Registro" : "Nuevo Registro")
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Estudio *</label>
                        <select class="form-select" @bind="modelo.estudio" disabled="@editando">
                            <option value="">-- Seleccionar Estudio --</option>
                            @foreach (var estudio in listadoEstudios)
                            {
                                <option value="@estudio["id"]">@estudio["titulo"]</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Área de Conocimiento *</label>
                        <select class="form-select" @bind="modelo.area_conocimiento" disabled="@editando">
                            <option value="">-- Seleccionar Área --</option>
                            @foreach (var area in listadoAreas)
                            {
                                <option value="@area["id"]">@area["gran_area"] - @area["area"] - @area["disciplina"]</option>
                            }
                        </select>
                    </div>
                </div>
                <button class="btn btn-success me-2" @onclick="GuardarRegistro">Guardar</button>
                <button class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
            </div>
        </div>
    }

    @if (cargando)
    {
        <div class="text-center">
            <div class="spinner-border text-primary"></div>
        </div>
    }

    @if (!cargando && registros.Any())
    {
        <table class="table table-striped table-hover table-sm">
            <thead class="table-dark">
                <tr>
                    <th>Estudio</th>
                    <th>Área de Conocimiento</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var reg in registros)
                {
                    <tr>
                        <td>@ObtenerTituloEstudio(Convert.ToInt32(reg["estudio"]))</td>
                        <td>@ObtenerNombreArea(Convert.ToInt32(reg["area_conocimiento"]))</td>
                        <td>
                            <button class="btn btn-warning btn-sm me-1" @onclick="() => EditarRegistro(reg)">
                                Editar
                            </button>
                            <button class="btn btn-danger btn-sm" @onclick="() => EliminarRegistro(reg)">
                                Eliminar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (!cargando && !registros.Any())
    {
        <div class="alert alert-warning">No se encontraron registros.</div>
    }
</div>

@code {
    private List<Dictionary<string, object?>> registros = new();
    private List<Dictionary<string, object?>> listadoEstudios = new();
    private List<Dictionary<string, object?>> listadoAreas = new();
    private bool cargando = true;
    private bool mostrarFormulario = false;
    private bool editando = false;
    private string mensaje = string.Empty;
    private bool exito = false;

    private EstudioACModel modelo = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        cargando = true;
        registros = await Api.ListarAsync("estudio_ac", null);
        listadoEstudios = await Api.ListarAsync("estudios_realizados", null);
        listadoAreas = await Api.ListarAsync("area_conocimiento", null);
        cargando = false;
    }

    private void NuevoRegistro()
    {
        modelo = new EstudioACModel();
        editando = false;
        mostrarFormulario = true;
    }

    private void EditarRegistro(Dictionary<string, object?> reg)
    {
        modelo = new EstudioACModel
        {
            estudio = reg["estudio"]?.ToString() ?? "",
            area_conocimiento = reg["area_conocimiento"]?.ToString() ?? ""
        };
        editando = true;
        mostrarFormulario = true;
    }

    private async Task GuardarRegistro()
    {
        var datos = new Dictionary<string, object?>
        {
            { "estudio", int.Parse(modelo.estudio) },
            { "area_conocimiento", int.Parse(modelo.area_conocimiento) }
        };

        if (editando)
        {
            (exito, mensaje) = await Api.ActualizarAsync("estudio_ac", "estudio", modelo.estudio, datos);
        }
        else
        {
            (exito, mensaje) = await Api.CrearAsync("estudio_ac", datos);
        }

        if (exito)
        {
            Cancelar();
            await CargarDatos();
        }
    }

    private async Task EliminarRegistro(Dictionary<string, object?> reg)
    {
        var estudio = Convert.ToInt32(reg["estudio"]);
        var area_conocimiento = Convert.ToInt32(reg["area_conocimiento"]);
        if (!await ConfirmarEliminacion()) return;

        (exito, mensaje) = await Api.EliminarAsync("estudio_ac", "estudio", estudio.ToString());
        await CargarDatos();
    }

    private void Cancelar()
    {
        mostrarFormulario = false;
        modelo = new EstudioACModel();
    }

    private Task<bool> ConfirmarEliminacion() => Task.FromResult(true);

    private string ObtenerTituloEstudio(int id)
    {
        var estudio = listadoEstudios.FirstOrDefault(e => Convert.ToInt32(e["id"]) == id);
        return estudio?["titulo"]?.ToString() ?? id.ToString();
    }

    private string ObtenerNombreArea(int id)
    {
        var area = listadoAreas.FirstOrDefault(a => Convert.ToInt32(a["id"]) == id);
        return area != null ? $"{area["gran_area"]} - {area["area"]}" : id.ToString();
    }

    private class EstudioACModel
    {
        public string estudio { get; set; } = "";
        public string area_conocimiento { get; set; } = "";
    }
}
