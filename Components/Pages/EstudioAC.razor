@page "/estudio-ac"
@inject FrontBlazor_AppiGenericaCsharp.Services.ApiService Api
@inject FrontBlazor_AppiGenericaCsharp.Services.SpService Sp

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Relacionar Estudio con Área de Conocimiento</h4>
        </div>
        <div class="card-body p-4">
            <div class="row">
                <div class="col-md-6 mb-4">
                    <label class="form-label fw-bold">Estudio Realizado:</label>
                    <select class="form-select form-select-lg" @bind="idEstudioSeleccionado">
                        <option value="0">-- Seleccione un estudio --</option>
                        @foreach (var estudio in listaEstudios)
                        {
                            @* CAMBIA "id" y "nombre" por las columnas reales de tu tabla de estudios *@
                            <option value="@estudio["id"]">@estudio["nombre"]</option>
                        }
                    </select>
                </div>

                <div class="col-md-6 mb-4">
                    <label class="form-label fw-bold">Área de Conocimiento:</label>
                    <select class="form-select form-select-lg" @bind="idAreaSeleccionada">
                        <option value="0">-- Seleccione un área --</option>
                        @foreach (var area in listaAreas)
                        {
                            @* CAMBIA "id" y "nombre" por las columnas reales de tu tabla de áreas *@
                            <option value="@area["id"]">@area["nombre"]</option>
                        }
                    </select>
                </div>
            </div>

            <div class="d-flex justify-content-end">
                <button class="btn btn-success btn-lg px-5" 
                        @onclick="GuardarRelacion" 
                        disabled="@(idEstudioSeleccionado == 0 || idAreaSeleccionada == 0)">
                    Guardar Relación
                </button>
            </div>

            @if (!string.IsNullOrEmpty(mensajeAlerta))
            {
                <div class="alert @(esExito ? "alert-success" : "alert-danger") mt-4 alert-dismissible fade show" role="alert">
                    @mensajeAlerta
                    <button type="button" class="btn-close" @onclick="() => mensajeAlerta = string.Empty"></button>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<Dictionary<string, object?>> listaEstudios = new();
    private List<Dictionary<string, object?>> listaAreas = new();

    private int idEstudioSeleccionado = 0;
    private int idAreaSeleccionada = 0;

    private string mensajeAlerta = string.Empty;
    private bool esExito = false;

    protected override async Task OnInitializedAsync()
    {
        // Usamos ApiService para los GET (Listar)
        listaAreas = await Api.ListarAsync("dbo.area_conocimiento");
        listaEstudios = await Api.ListarAsync("dbo.estudio_ac"); // Revisa si tu tabla maestra de estudios se llama distinto
    }

    private async Task GuardarRelacion()
    {
        // 1. Preparamos los parámetros exactos que espera tu Procedimiento Almacenado
        var parametrosSP = new Dictionary<string, object?>
        {
            { "estudio", idEstudioSeleccionado },
            { "area_conocimiento", idAreaSeleccionada }
        };

        // 2. Ejecutamos el SP usando tu nuevo servicio
        // El primer parámetro es el nombre exacto de tu procedimiento en SQL
        var resultado = await Sp.EjecutarSpAsync("sp_InsertarEstudioAC", parametrosSP);

        esExito = resultado.exito;
        mensajeAlerta = resultado.mensaje;

        if (esExito)
        {
            idEstudioSeleccionado = 0;
            idAreaSeleccionada = 0;
        }
    }
}