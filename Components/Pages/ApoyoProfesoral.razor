@page "/apoyo-profesoral"
@rendermode InteractiveServer
@inject FrontBlazor_AppiGenericaCsharp.Services.ApiService Api

<PageTitle>Apoyo Profesoral</PageTitle>

<div class="container mt-4">
    <h3>Gestión de Apoyo Profesoral</h3>

    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="alert @(exito ? "alert-success" : "alert-danger") alert-dismissible fade show">
            @mensaje
            <button type="button" class="btn-close" @onclick="() => mensaje = string.Empty"></button>
        </div>
    }

    @if (!mostrarFormulario)
    {
        <button class="btn btn-primary mb-3" @onclick="NuevoRegistro">Nuevo Registro</button>
    }

    @if (mostrarFormulario)
    {
        <div class="card mb-3">
            <div class="card-header">
                @(editando ? "Editar Registro" : "Nuevo Registro")
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Estudio *</label>
                        <select class="form-select" @bind="modelo.estudios" disabled="@editando">
                            <option value="">-- Seleccionar Estudio --</option>
                            @foreach (var estudio in listadoEstudios)
                            {
                                <option value="@estudio["id"]">@estudio["titulo"]</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">¿Con Apoyo?</label>
                        <select class="form-select" @bind="modelo.con_apoyo">
                            <option value="false">No</option>
                            <option value="true">Sí</option>
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Institución</label>
                        <input class="form-control" @bind="modelo.institucion" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Tipo</label>
                        <input class="form-control" @bind="modelo.tipo" />
                    </div>
                </div>
                <button class="btn btn-success me-2" @onclick="GuardarRegistro">Guardar</button>
                <button class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
            </div>
        </div>
    }

    @if (cargando)
    {
        <div class="text-center">
            <div class="spinner-border text-primary"></div>
        </div>
    }

    @if (!cargando && registros.Any())
    {
        <table class="table table-striped table-hover table-sm">
            <thead class="table-dark">
                <tr>
                    <th>Estudio</th>
                    <th>Con Apoyo</th>
                    <th>Institución</th>
                    <th>Tipo</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var reg in registros)
                {
                    <tr>
                        <td>@ObtenerTituloEstudio(Convert.ToInt32(reg["estudios"]))</td>
                        <td>@(Convert.ToBoolean(reg["con_apoyo"]) ? "Sí" : "No")</td>
                        <td>@reg["institucion"]</td>
                        <td>@reg["tipo"]</td>
                        <td>
                            <button class="btn btn-warning btn-sm me-1" @onclick="() => EditarRegistro(reg)">
                                Editar
                            </button>
                            <button class="btn btn-danger btn-sm" @onclick="() => EliminarRegistro(reg)">
                                Eliminar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (!cargando && !registros.Any())
    {
        <div class="alert alert-warning">No se encontraron registros.</div>
    }
</div>

@code {
    private List<Dictionary<string, object?>> registros = new();
    private List<Dictionary<string, object?>> listadoEstudios = new();
    private bool cargando = true;
    private bool mostrarFormulario = false;
    private bool editando = false;
    private string mensaje = string.Empty;
    private bool exito = false;

    private ApoyoModel modelo = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

private async Task CargarDatos()
{
    try 
    {
        cargando = true;
        // Intentamos cargar los registros. Si falla, el catch lo atrapa.
        var resultado = await Api.ListarAsync("apoyo_profesoral");
        registros = resultado ?? new List<Dictionary<string, object?>>();

        // Cargamos los estudios para el select
        var estudios = await Api.ListarAsync("estudios_realizados");
        listadoEstudios = estudios ?? new List<Dictionary<string, object?>>();
    }
    catch (Exception ex)
    {
        // Esto evita que salga la pantalla de error blanca.
        // El error se imprimirá solo en la consola de depuración.
        Console.WriteLine($"Aviso: Error de comunicación en Apoyo: {ex.Message}");
        registros = new List<Dictionary<string, object?>>();
    }
    finally
    {
        cargando = false;
        StateHasChanged();
    }
}
    private void NuevoRegistro()
    {
        modelo = new ApoyoModel();
        editando = false;
        mostrarFormulario = true;
    }

    private void EditarRegistro(Dictionary<string, object?> reg)
    {
        modelo = new ApoyoModel
        {
            estudios = reg["estudios"]?.ToString() ?? "",
            con_apoyo = Convert.ToBoolean(reg["con_apoyo"]).ToString(),
            institucion = reg["institucion"]?.ToString() ?? "",
            tipo = reg["tipo"]?.ToString() ?? ""
        };
        editando = true;
        mostrarFormulario = true;
    }

    private async Task GuardarRegistro()
    {
        var datos = new Dictionary<string, object?>
        {
            { "estudios", int.Parse(modelo.estudios) },
            { "con_apoyo", bool.Parse(modelo.con_apoyo) },
            { "institucion", modelo.institucion },
            { "tipo", modelo.tipo }
        };

        if (editando)
        {
            (exito, mensaje) = await Api.ActualizarAsync("apoyo_profesoral", "estudios", modelo.estudios, datos);
        }
        else
        {
            (exito, mensaje) = await Api.CrearAsync("apoyo_profesoral", datos);
        }

        if (exito)
        {
            Cancelar();
            await CargarDatos();
        }
    }

    private async Task EliminarRegistro(Dictionary<string, object?> reg)
    {
        var estudios = Convert.ToInt32(reg["estudios"]);
        if (!await ConfirmarEliminacion()) return;

        (exito, mensaje) = await Api.EliminarAsync("apoyo_profesoral", "estudios", estudios.ToString());
        await CargarDatos();
    }

    private void Cancelar()
    {
        mostrarFormulario = false;
        modelo = new ApoyoModel();
    }

    private Task<bool> ConfirmarEliminacion() => Task.FromResult(true);

    private string ObtenerTituloEstudio(int id)
    {
        var estudio = listadoEstudios.FirstOrDefault(e => Convert.ToInt32(e["id"]) == id);
        return estudio?["titulo"]?.ToString() ?? id.ToString();
    }

    private class ApoyoModel
    {
        public string estudios { get; set; } = "";
        public string con_apoyo { get; set; } = "false";
        public string institucion { get; set; } = "";
        public string tipo { get; set; } = "";
    }
}
