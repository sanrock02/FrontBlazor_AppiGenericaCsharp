@page "/login"
@using Microsoft.AspNetCore.Components.Web
@inject FrontBlazor_AppiGenericaCsharp.Services.AuthService AuthService
@inject NavigationManager NavManager

<div class="container-fluid d-flex justify-content-center align-items-center vh-100" 
     style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
    
    <div class="card p-4 p-md-5 shadow-2xl" 
         style="max-width: 420px; width: 100%; border-radius: 24px; border: 1px solid rgba(255,255,255,0.2); background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px);">
        
        <div class="text-center mb-4">
            <div class="d-inline-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary rounded-circle mb-3" style="width: 60px; height: 60px;">
                <i class="bi bi-shield-lock-fill fs-3"></i>
            </div>
            <h3 class="fw-extrabold text-dark tracking-tight mb-1" style="font-size: 1.75rem;">¡Bienvenido de nuevo!</h3>
            <p class="text-muted small">Por favor, ingresa tus credenciales para continuar</p>
        </div>

        @if (!string.IsNullOrEmpty(mensajeError))
        {
            <div class="alert alert-danger d-flex align-items-center justify-content-center rounded-3 border-0 py-2.5 mb-4" role="alert" style="background-color: #fde8e8; color: #9b1c1c;">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <span class="small fw-medium">@mensajeError</span>
            </div>
        }

        <EditForm Model="@Model" OnValidSubmit="EjecutarIngreso" FormName="loginForm" method="post">
            <DataAnnotationsValidator />

            <div class="form-floating mb-3">
                <InputText class="form-control rounded-3" id="floatingUsuario" @bind-Value="Model.Usuario" placeholder="Ej: admin1@correo.com" style="border: 1.5px solid #e5e7eb;" required />
                <label for="floatingUsuario" class="text-muted"><i class="bi bi-envelope me-2"></i>Usuario (Email)</label>
            </div>

            <div class="form-floating mb-4">
                <InputText type="password" class="form-control rounded-3" id="floatingPassword" @bind-Value="Model.Contrasena" placeholder="••••••••" style="border: 1.5px solid #e5e7eb;" required />
                <label for="floatingPassword" class="text-muted"><i class="bi bi-lock me-2"></i>Contraseña</label>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-3 fw-bold rounded-3 shadow-sm transition-all" 
                    style="background: linear-gradient(to right, #4f46e5, #7c3aed); border: none; letter-spacing: 0.5px;">
                Iniciar Sesión <i class="bi bi-arrow-right ms-2"></i>
            </button>
        </EditForm>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    public LoginData Model { get; set; } = new();

    private string? mensajeError;

    private async Task EjecutarIngreso()
    {
        if (string.IsNullOrWhiteSpace(Model.Usuario) || string.IsNullOrWhiteSpace(Model.Contrasena))
        {
            mensajeError = "Por favor, escribe tus datos antes de ingresar.";
            return;
        }

        var resultado = await AuthService.LoginAsync(Model.Usuario, Model.Contrasena);

        if (resultado.exito)
        {
            NavManager.NavigateTo("/"); 
        }
        else
        {
            mensajeError = resultado.mensaje;
        }
    }

    public class LoginData
    {
        public string Usuario { get; set; } = string.Empty;
        public string Contrasena { get; set; } = string.Empty;
    }
}