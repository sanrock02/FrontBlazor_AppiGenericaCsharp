@page "/intereses-futuros"
@rendermode InteractiveServer
@inject FrontBlazor_AppiGenericaCsharp.Services.ApiService Api

<PageTitle>Intereses Futuros</PageTitle>

<div class="container mt-4">
    <h3>Gestión de Intereses Futuros de Docentes</h3>

    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="alert @(exito ? "alert-success" : "alert-danger") alert-dismissible fade show">
            @mensaje
            <button type="button" class="btn-close" @onclick="() => mensaje = string.Empty"></button>
        </div>
    }

    @if (!mostrarFormulario)
    {
        <button class="btn btn-primary mb-3" @onclick="NuevoRegistro">Nuevo Interés</button>
    }

    @if (mostrarFormulario)
    {
        <div class="card mb-3">
            <div class="card-header">
                @(editando ? "Editar Interés" : "Nuevo Interés")
            </div>
            <div class="card-body">
                <div class="row">
                    @if (editando)
                    {
                        <div class="col-md-6 mb-3">
                            <label class="form-label">ID</label>
                            <input class="form-control" type="number" @bind="modelo.id" disabled="true" />
                        </div>
                    }
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Docente *</label>
                        <select class="form-select" @bind="modelo.docente">
                            <option value="">-- Seleccionar Docente --</option>
                            @foreach (var docente in listadoDocentes)
                            {
                                <option value="@docente["cedula"]">@docente["nombres"] @docente["apellidos"]</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-12 mb-3">
                        <label class="form-label">Interés o Objetivo</label>
                        <textarea class="form-control" rows="3" @bind="modelo.interes"></textarea>
                    </div>
                </div>
                <button class="btn btn-success me-2" @onclick="GuardarRegistro">Guardar</button>
                <button class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
            </div>
        </div>
    }

    @if (cargando)
    {
        <div class="text-center">
            <div class="spinner-border text-primary"></div>
        </div>
    }

    @if (!cargando && registros.Any())
    {
        <table class="table table-striped table-hover table-sm">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Docente</th>
                    <th>Interés</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var reg in registros)
                {
                    <tr>
                        <td>@reg["id"]</td>
                        <td>@ObtenerNombreDocente(Convert.ToInt32(reg["docente"]))</td>
                        <td>@reg["interes"]</td>
                        <td>
                            <button class="btn btn-warning btn-sm me-1" @onclick="() => EditarRegistro(reg)">
                                Editar
                            </button>
                            <button class="btn btn-danger btn-sm" @onclick="() => EliminarRegistro(reg)">
                                Eliminar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (!cargando && !registros.Any())
    {
        <div class="alert alert-warning">No se encontraron registros.</div>
    }
</div>

@code {
    private List<Dictionary<string, object?>> registros = new();
    private List<Dictionary<string, object?>> listadoDocentes = new();
    private bool cargando = true;
    private bool mostrarFormulario = false;
    private bool editando = false;
    private string mensaje = string.Empty;
    private bool exito = false;

    private InteresesModel modelo = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        cargando = true;
        registros = await Api.ListarAsync("intereses_futuros", null);
        listadoDocentes = await Api.ListarAsync("docente", null);
        cargando = false;
    }

    private void NuevoRegistro()
    {
        modelo = new InteresesModel();
        editando = false;
        mostrarFormulario = true;
    }

    private void EditarRegistro(Dictionary<string, object?> reg)
    {
        modelo = new InteresesModel
        {
            id = Convert.ToInt32(reg["id"]),
            docente = reg["docente"]?.ToString() ?? "",
            interes = reg["interes"]?.ToString() ?? ""
        };
        editando = true;
        mostrarFormulario = true;
    }

    private async Task GuardarRegistro()
    {
        var datos = new Dictionary<string, object?>
        {
            { "docente", int.Parse(modelo.docente) },
            { "interes", modelo.interes }
        };

        if (editando)
        {
            datos.Add("id", modelo.id);
            (exito, mensaje) = await Api.ActualizarAsync("intereses_futuros", "id", modelo.id.ToString(), datos);
        }
        else
        {
            datos.Add("id", modelo.id > 0 ? modelo.id : 0);
            (exito, mensaje) = await Api.CrearAsync("intereses_futuros", datos);
        }

        if (exito)
        {
            Cancelar();
            await CargarDatos();
        }
    }

    private async Task EliminarRegistro(Dictionary<string, object?> reg)
    {
        var id = Convert.ToInt32(reg["id"]);
        if (!await ConfirmarEliminacion()) return;

        (exito, mensaje) = await Api.EliminarAsync("intereses_futuros", "id", id.ToString());
        await CargarDatos();
    }

    private void Cancelar()
    {
        mostrarFormulario = false;
        modelo = new InteresesModel();
    }

    private Task<bool> ConfirmarEliminacion() => Task.FromResult(true);

    private string ObtenerNombreDocente(int cedula)
    {
        var docente = listadoDocentes.FirstOrDefault(d => Convert.ToInt32(d["cedula"]) == cedula);
        return docente != null ? $"{docente["nombres"]} {docente["apellidos"]}" : cedula.ToString();
    }

    private class InteresesModel
    {
        public int id { get; set; }
        public string docente { get; set; } = "";
        public string interes { get; set; } = "";
    }
}
