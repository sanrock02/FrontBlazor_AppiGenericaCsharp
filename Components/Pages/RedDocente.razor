@page "/red-docente"
@rendermode InteractiveServer
@inject FrontBlazor_AppiGenericaCsharp.Services.ApiService Api

<PageTitle>Redes de Docentes</PageTitle>

<div class="container mt-4">
    <h3>Gestión de Docentes en Redes</h3>

    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="alert @(exito ? "alert-success" : "alert-danger") alert-dismissible fade show">
            @mensaje
            <button type="button" class="btn-close" @onclick="() => mensaje = string.Empty"></button>
        </div>
    }

    @if (!mostrarFormulario)
    {
        <button class="btn btn-primary mb-3" @onclick="NuevoRegistro">Nuevo Registro</button>
    }

    @if (mostrarFormulario)
    {
        <div class="card mb-3">
            <div class="card-header">
                @(editando ? "Editar Registro" : "Nuevo Registro")
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Red *</label>
                        <select class="form-select" @bind="modelo.red" disabled="@editando">
                            <option value="">-- Seleccionar Red --</option>
                            @foreach (var red in listadoRedes)
                            {
                                <option value="@red["idr"]">@red["nombre"]</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Docente *</label>
                        <select class="form-select" @bind="modelo.docente" disabled="@editando">
                            <option value="">-- Seleccionar Docente --</option>
                            @foreach (var docente in listadoDocentes)
                            {
                                <option value="@docente["cedula"]">@docente["nombres"] @docente["apellidos"]</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Fecha Inicio</label>
                        <input class="form-control" type="date" @bind="modelo.fecha_inicio" @bind:format="yyyy-MM-dd" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Fecha Fin</label>
                        <input class="form-control" type="date" @bind="modelo.fecha_fin" @bind:format="yyyy-MM-dd" />
                    </div>
                    <div class="col-md-12 mb-3">
                        <label class="form-label">Actividades Destacadas</label>
                        <textarea class="form-control" rows="3" @bind="modelo.act_destacadas"></textarea>
                    </div>
                </div>
                <button class="btn btn-success me-2" @onclick="GuardarRegistro">Guardar</button>
                <button class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
            </div>
        </div>
    }

    @if (cargando)
    {
        <div class="text-center">
            <div class="spinner-border text-primary"></div>
        </div>
    }

    @if (!cargando && registros.Any())
    {
        <table class="table table-striped table-hover table-sm">
            <thead class="table-dark">
                <tr>
                    <th>Red</th>
                    <th>Docente</th>
                    <th>Fecha Inicio</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var reg in registros)
                {
                    <tr>
                        <td>@ObtenerNombreRed(Convert.ToInt32(reg["red"]))</td>
                        <td>@ObtenerNombreDocente(Convert.ToInt32(reg["docente"]))</td>
                        <td>@reg["fecha_inicio"]</td>
                        <td>
                            <button class="btn btn-warning btn-sm me-1" @onclick="() => EditarRegistro(reg)">
                                Editar
                            </button>
                            <button class="btn btn-danger btn-sm" @onclick="() => EliminarRegistro(reg)">
                                Eliminar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (!cargando && !registros.Any())
    {
        <div class="alert alert-warning">No se encontraron registros.</div>
    }
</div>

@code {
    private List<Dictionary<string, object?>> registros = new();
    private List<Dictionary<string, object?>> listadoRedes = new();
    private List<Dictionary<string, object?>> listadoDocentes = new();
    private bool cargando = true;
    private bool mostrarFormulario = false;
    private bool editando = false;
    private string mensaje = string.Empty;
    private bool exito = false;

    private RedDocenteModel modelo = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        cargando = true;
        registros = await Api.ListarAsync("red_docente", null);
        listadoRedes = await Api.ListarAsync("red", null);
        listadoDocentes = await Api.ListarAsync("docente", null);
        cargando = false;
    }

    private void NuevoRegistro()
    {
        modelo = new RedDocenteModel();
        editando = false;
        mostrarFormulario = true;
    }

    private void EditarRegistro(Dictionary<string, object?> reg)
    {
        modelo = new RedDocenteModel
        {
            red = reg["red"]?.ToString() ?? "",
            docente = reg["docente"]?.ToString() ?? "",
            fecha_inicio = reg["fecha_inicio"] != null ? Convert.ToDateTime(reg["fecha_inicio"]) : null,
            fecha_fin = reg["fecha_fin"] != null ? Convert.ToDateTime(reg["fecha_fin"]) : null,
            act_destacadas = reg["act_destacadas"]?.ToString() ?? ""
        };
        editando = true;
        mostrarFormulario = true;
    }

    private async Task GuardarRegistro()
    {
        var datos = new Dictionary<string, object?>
        {
            { "red", int.Parse(modelo.red) },
            { "docente", int.Parse(modelo.docente) },
            { "fecha_inicio", modelo.fecha_inicio?.ToString("yyyy-MM-dd") },
            { "fecha_fin", modelo.fecha_fin?.ToString("yyyy-MM-dd") },
            { "act_destacadas", modelo.act_destacadas }
        };

        if (editando)
        {
            (exito, mensaje) = await Api.ActualizarAsync("red_docente", "red", modelo.red, datos);
        }
        else
        {
            (exito, mensaje) = await Api.CrearAsync("red_docente", datos);
        }

        if (exito)
        {
            Cancelar();
            await CargarDatos();
        }
    }

    private async Task EliminarRegistro(Dictionary<string, object?> reg)
    {
        var red = Convert.ToInt32(reg["red"]);
        var docente = Convert.ToInt32(reg["docente"]);
        if (!await ConfirmarEliminacion()) return;

        (exito, mensaje) = await Api.EliminarAsync("red_docente", "red", red.ToString());
        await CargarDatos();
    }

    private void Cancelar()
    {
        mostrarFormulario = false;
        modelo = new RedDocenteModel();
    }

    private Task<bool> ConfirmarEliminacion() => Task.FromResult(true);

    private string ObtenerNombreRed(int idr)
    {
        var red = listadoRedes.FirstOrDefault(r => Convert.ToInt32(r["idr"]) == idr);
        return red?["nombre"]?.ToString() ?? idr.ToString();
    }

    private string ObtenerNombreDocente(int cedula)
    {
        var docente = listadoDocentes.FirstOrDefault(d => Convert.ToInt32(d["cedula"]) == cedula);
        return docente != null ? $"{docente["nombres"]} {docente["apellidos"]}" : cedula.ToString();
    }

    private class RedDocenteModel
    {
        public string red { get; set; } = "";
        public string docente { get; set; } = "";
        public DateTime? fecha_inicio { get; set; }
        public DateTime? fecha_fin { get; set; }
        public string act_destacadas { get; set; } = "";
    }
}
